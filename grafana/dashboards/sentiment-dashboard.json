{
  "title": "Sentiment Analysis API",
  "uid": "sentiment-api",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Throughput – Predictions per Second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(prediction_requests_total[1m])",
          "legendFormat": "{{sentiment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Sentiment Distribution",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "prediction_requests_total",
          "legendFormat": "{{sentiment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency – Average Response Time (s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(prediction_latency_seconds_sum[1m]) / rate(prediction_latency_seconds_count[1m])",
          "legendFormat": "avg latency",
          "refId": "A"
        }
      ]
    }
  ]
}
